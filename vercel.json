{
  "version": 2,
  "rewrites": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404/" }
  ],
  "headers": [
    {
      "source": "(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=86400, max-age=86400"
        }
      ]
    }
  ]
}